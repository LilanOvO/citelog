{
  "manifest_version": 3,
  "name": "CiteLog",
  "version": "0.1.5",
  "description": "轻量记录 Google Scholar 引用变化，在浏览来源页时同步引用文章。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://scholar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CiteLog"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.com/scholar*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https://scholar.google.com; img-src 'self' data:; style-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
